# Upstream clones used as build inputs / references. The opentegra
# work lives in its own fork: github.com/LBSiUK/xf86-video-opentegra
# (branch: dri3-present). Other entries here are unmodified upstreams
# pulled fresh by anyone wanting to reproduce the build.
src/

# ccache for the cross-build container
.ccache/

# APK build outputs from abuild (rebuild on demand)
packaging/apk-out/
packaging/.distfiles/

# Staged install tarballs for device deploy (rebuild on demand from
# Dockerfile.grate-mesa-build + src/grate-mesa-grate branch).
artifacts/

# Built test binaries (architecture-specific; rebuild on demand)
test/dri3_test
test/flipdemo

# Editor / OS junk
.DS_Store
*.swp
*~

# Session handoff for next Claude Code session — local-only, may
# contain device IPs / paths but never passwords.
HANDOFF.md
