#!/usr/bin/env expect
# Usage: rt_ssh.exp <remote_command>
#
# Runs a command over ssh as RT_USER on the Surface RT (no doas). Useful
# for X clients that talk to that user's X session, or any unprivileged
# command. Connection settings come from RT_HOST, RT_USER, RT_PORT,
# RT_PASS and RT_SSH_OPTS; see rt_common.tcl for defaults.

source [file join [file dirname [info script]] rt_common.tcl]

if {[llength $argv] != 1} {
    send_user "usage: [file tail $argv0] <remote_command>\n"
    exit 2
}
set cmd [lindex $argv 0]

spawn ssh -tt {*}$rt_ssh_opts -p $rt_port $rt_user@$rt_host "sh -c [rt_shquote $cmd]"
rt_finish
