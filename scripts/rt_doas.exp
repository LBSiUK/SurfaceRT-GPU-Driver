#!/usr/bin/env expect
# Usage: rt_doas.exp <remote_command>
#
# Runs a command as root (via doas) on the Surface RT, answering both the
# ssh and the doas password prompts, for headless deploys. Connection
# settings come from RT_HOST, RT_USER, RT_PORT, RT_PASS and RT_SSH_OPTS;
# see rt_common.tcl for defaults.

source [file join [file dirname [info script]] rt_common.tcl]

if {[llength $argv] != 1} {
    send_user "usage: [file tail $argv0] <remote_command>\n"
    exit 2
}
set cmd [lindex $argv 0]

spawn ssh -tt {*}$rt_ssh_opts -p $rt_port $rt_user@$rt_host "doas sh -c [rt_shquote $cmd]"
rt_finish
