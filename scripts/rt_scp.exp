#!/usr/bin/env expect
# Usage: rt_scp.exp <local_path> <remote_path>
#
# Copies a local file to the Surface RT over scp, answering the password
# prompt. Connection settings come from RT_HOST, RT_USER, RT_PORT,
# RT_PASS and RT_SSH_OPTS; see rt_common.tcl for defaults.

source [file join [file dirname [info script]] rt_common.tcl]

if {[llength $argv] != 2} {
    send_user "usage: [file tail $argv0] <local_path> <remote_path>\n"
    exit 2
}
set src [lindex $argv 0]
set dst [lindex $argv 1]

spawn scp {*}$rt_ssh_opts -P $rt_port $src $rt_user@$rt_host:$dst
rt_finish
